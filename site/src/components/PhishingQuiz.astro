---
import DocsLayout from "../layouts/DocsLayout.astro";

interface Props {
  quiz: {
    title: string;
    description: string;
    intro: string;
    notice: string;
    instructions: string;
    labels: Record<string, string>;
    questions: {
      id: string;
      title: string;
      prompt: string;
      context: string;
      options: string[];
      answer: number;
      explanation: string;
    }[];
    completion: { title: string; body: string; linkText: string; linkHref: string };
    sourcesTitle?: string;
    sources?: { title: string; url: string; questions: string[] }[];
  };
  currentSlug: string;
  canonical?: string;
}

const { quiz, currentSlug, canonical } = Astro.props;
const { labels, questions, completion } = quiz;
const textFields = ["title", "description", "intro", "notice", "instructions"] as const;
const labelFields = ["question", "of", "check", "next", "previous", "restart", "correct", "incorrect", "answer", "progress", "completed", "review", "noJavascript"] as const;
const isText = (value: unknown): value is string => typeof value === "string" && value.trim().length > 0;
if (
  !textFields.every((key) => isText(quiz[key])) ||
  !labelFields.every((key) => isText(labels?.[key])) ||
  !Array.isArray(questions) || questions.length !== 10 ||
  !questions.every((question) =>
    [question.id, question.title, question.prompt, question.explanation].every(isText) &&
    typeof question.context === "string" &&
    Array.isArray(question.options) && question.options.length === 3 &&
    question.options.every(isText) &&
    Number.isInteger(question.answer) && question.answer >= 0 && question.answer <= 2
  ) ||
  new Set(questions.map((question) => question.id)).size !== questions.length ||
  ![completion?.title, completion?.body, completion?.linkText, completion?.linkHref].every(isText)
) {
  throw new Error("Invalid phishing quiz data contract");
}
const learningUrl = new URL(completion.linkHref, "https://www.nis2compass.eu");
if (!["https:", "http:"].includes(learningUrl.protocol)) {
  throw new Error("Invalid phishing quiz learning link protocol");
}
const isHttpsUrl = (value: unknown) => {
  if (!isText(value)) return false;
  try {
    return new URL(value).protocol === "https:";
  } catch {
    return false;
  }
};
const questionIds = new Set(questions.map((question) => question.id));
if (quiz.sources !== undefined || quiz.sourcesTitle !== undefined) {
  if (
    !isText(quiz.sourcesTitle) ||
    !Array.isArray(quiz.sources) || quiz.sources.length === 0 ||
    !quiz.sources.every((source) =>
      source && isText(source.title) && isHttpsUrl(source.url) &&
      Array.isArray(source.questions) && source.questions.length > 0 &&
      source.questions.every((id) => isText(id) && questionIds.has(id)) &&
      new Set(source.questions).size === source.questions.length
    ) ||
    new Set(quiz.sources.map((source) => new URL(source.url).href)).size !== quiz.sources.length ||
    new Set(quiz.sources.flatMap((source) => source.questions)).size !== questionIds.size
  ) {
    throw new Error("Invalid phishing quiz sources contract");
  }
}
---
<DocsLayout title={quiz.title} description={quiz.description} currentSlug={currentSlug} canonical={canonical}>
  <div class="rendered-doc phishing-quiz" data-phishing-quiz data-correct={labels.correct} data-incorrect={labels.incorrect}>
    <h1>{quiz.title}</h1>
    <p>{quiz.intro}</p>
    <p class="quiz-notice position-box">{quiz.notice}</p>
    <p id="quiz-instructions">{quiz.instructions}</p>

    <div data-interactive hidden>
      <div class="quiz-progress">
        <label for="quiz-progress">{labels.progress}: <span data-reviewed>0</span> {labels.of} {questions.length}</label>
        <progress id="quiz-progress" value="0" max={questions.length}></progress>
      </div>
      <div data-questions>
        {questions.map((question, index) => (
          <section data-question data-answer={question.answer} hidden aria-labelledby={`quiz-heading-${index}`}>
            <h2 id={`quiz-heading-${index}`} tabindex="-1" data-question-heading>
              <span class="quiz-position">{labels.question} {index + 1} {labels.of} {questions.length}</span>
              {question.title}
            </h2>
            {question.context && <p id={`quiz-context-${index}`} class="quiz-context">{question.context}</p>}
            <form data-question-form autocomplete="off">
              <fieldset aria-describedby={`quiz-instructions${question.context ? ` quiz-context-${index}` : ""}`}>
                <legend>{question.prompt}</legend>
                <div class="quiz-options">
                  {question.options.map((option, optionIndex) => (
                    <label class="quiz-option" for={`quiz-option-${index}-${optionIndex}`}>
                      <input type="radio" name={`quiz-choice-${index}`} id={`quiz-option-${index}-${optionIndex}`} value={optionIndex} required />
                      <span>{option}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
              <button type="submit" data-check disabled>{labels.check}</button>
            </form>
            <div class="quiz-feedback" data-feedback hidden>
              <p><strong data-result></strong></p>
              <p data-answer-text><strong>{labels.answer}:</strong> {question.options[question.answer]}</p>
              <p data-explanation>{question.explanation}</p>
            </div>
          </section>
        ))}
        <div class="quiz-actions">
          <button type="button" data-previous disabled>{labels.previous}</button>
          <button type="button" data-next disabled>{labels.next}</button>
          <button type="button" data-restart>{labels.restart}</button>
        </div>
      </div>
      <section data-completion hidden aria-labelledby="quiz-completion-heading">
        <h2 id="quiz-completion-heading" tabindex="-1">{completion.title}</h2>
        <p>{labels.completed}</p>
        <p>{completion.body}</p>
        <p><a href={completion.linkHref}>{completion.linkText}</a></p>
        <div class="quiz-actions">
          <button type="button" data-review>{labels.review}</button>
          <button type="button" data-restart>{labels.restart}</button>
        </div>
      </section>
      <p class="quiz-announcement" data-announcement role="status" aria-live="polite" aria-atomic="true"></p>
    </div>

    <!-- Visible by default, including when the module fails to load. -->
    <div data-static>
      <p>{labels.noJavascript}</p>
      {questions.map((question, index) => (
        <section aria-labelledby={`quiz-static-heading-${index}`}>
          <h2 id={`quiz-static-heading-${index}`}>
            <span class="quiz-position">{labels.question} {index + 1} {labels.of} {questions.length}</span>
            {question.title}
          </h2>
          {question.context && <p class="quiz-context">{question.context}</p>}
          <p><strong>{question.prompt}</strong></p>
          <ol>{question.options.map((option) => <li>{option}</li>)}</ol>
          <details>
            <summary>{labels.answer}</summary>
            <p><strong>{labels.correct}:</strong> {question.options[question.answer]}</p>
            <p>{question.explanation}</p>
          </details>
        </section>
      ))}
      <p><a href={completion.linkHref}>{completion.linkText}</a></p>
    </div>
  </div>
  {quiz.sources && quiz.sources.length > 0 && (
    <div class="rendered-doc quiz-sources">
      {quiz.sourcesTitle && <h2>{quiz.sourcesTitle}</h2>}
      <ul>
        {quiz.sources.map((source) => <li><a href={source.url}>{source.title}</a></li>)}
      </ul>
    </div>
  )}
</DocsLayout>

<script>
  import { initializeQuiz } from "../scripts/phishing-quiz.mjs";
  document.querySelectorAll<HTMLElement>("[data-phishing-quiz]").forEach(initializeQuiz);
</script>

<style>
  .phishing-quiz, .quiz-sources { max-width: 48rem; min-width: 0; letter-spacing: 0; }
  .phishing-quiz [hidden] { display: none !important; }
  .phishing-quiz h1 { font-size: 2rem; }
  .phishing-quiz h2, .quiz-sources h2 { font-size: 1.35rem; scroll-margin-top: 8rem; }
  .quiz-position { display: block; margin-bottom: 0.5rem; color: var(--muted); font-size: 0.9rem; font-weight: 500; }
  .quiz-context { white-space: pre-wrap; }
  .quiz-progress { margin: 1.5rem 0; }
  .quiz-progress label { display: block; margin-bottom: 0.4rem; }
  .quiz-progress progress { display: block; width: 100%; height: 0.6rem; accent-color: var(--blue); }
  fieldset { min-inline-size: 0; margin: 0 0 1rem; padding: 0; border: 0; }
  legend { max-width: 100%; padding: 0; font-weight: 650; }
  .quiz-options { display: grid; gap: 0.25rem; margin-top: 0.75rem; }
  .quiz-option { display: flex; align-items: flex-start; gap: 0.7rem; min-height: 2.75rem; padding: 0.65rem 0.5rem; border-bottom: 1px solid var(--line); cursor: pointer; }
  .quiz-option span { min-width: 0; }
  .quiz-option input { flex: 0 0 auto; width: 1.15rem; height: 1.15rem; margin: 0.22rem 0 0; accent-color: var(--blue); }
  .quiz-option:has(input:checked) { background: var(--field); }
  fieldset:disabled .quiz-option { cursor: default; }
  .quiz-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.5rem 0; padding-top: 1rem; border-top: 1px solid var(--line); }
  button { max-width: 100%; min-height: 2.75rem; padding: 0.5rem 0.85rem; border: 1px solid var(--muted); border-radius: 4px; color: var(--ink); background: var(--paper); font: inherit; font-weight: 650; line-height: 1.4; overflow-wrap: anywhere; cursor: pointer; }
  button:hover:not(:disabled):not([aria-disabled="true"]) { background: var(--field); }
  button:disabled, button[aria-disabled="true"] { color: var(--muted); border-color: var(--line); cursor: default; }
  [data-check]:not(:disabled):not([aria-disabled="true"]), [data-next]:not(:disabled) { color: white; background: var(--blue); border-color: var(--blue); }
  [data-check]:hover:not(:disabled):not([aria-disabled="true"]), [data-next]:hover:not(:disabled) { background: var(--green-dark); }
  .phishing-quiz :is(button, input, summary, a):focus-visible, .phishing-quiz h2:focus { outline: 3px solid var(--blue); outline-offset: 4px; }
  .quiz-feedback { margin: 1.25rem 0; padding-left: 1rem; border-left: 3px solid var(--blue); }
  .quiz-feedback p { margin: 0.5rem 0; }
  .quiz-feedback[data-correct="false"] { border-color: var(--danger); }
  .quiz-announcement { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 40rem) { .phishing-quiz h1 { font-size: 1.65rem; } }
</style>
